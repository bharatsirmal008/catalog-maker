# PostgreSQL connection string. Use a dedicated least-privilege application user.
DATABASE_URL="postgresql://catalog_user:replace-me@localhost:5432/catalog_maker?schema=public"

# Shopify Admin API (server-side only)
SHOPIFY_STORE_URL="https://your-development-store.myshopify.com"
SHOPIFY_CLIENT_ID="replace-me"
SHOPIFY_CLIENT_SECRET="replace-me"
SHOPIFY_API_VERSION="replace-with-supported-version"

# WooCommerce REST API (server-side only)
WOOCOMMERCE_STORE_URL="https://your-wordpress-site.example"
WOOCOMMERCE_CONSUMER_KEY="ck_replace-me"
WOOCOMMERCE_CONSUMER_SECRET="cs_replace-me"

# Authentication and application origin (server-side unless explicitly documented)
AUTH_SECRET="generate-a-long-random-value"
APP_URL="http://localhost:3000"
