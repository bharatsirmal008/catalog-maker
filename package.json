{
  "name": "catalog-maker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:hosted": "node scripts/start-hosted.mjs",
    "deploy:check": "node scripts/deployment-check.mjs",
    "build:deploy": "npm run deploy:check && npm run db:generate && npm run build",
    "db:deploy": "prisma migrate deploy",
    "deploy:initialize": "node --conditions=react-server --import tsx scripts/initialize-catalog.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:api": "node --conditions=react-server --import tsx tests/integration/api.ts",
    "test:import": "node --conditions=react-server --import tsx tests/integration/import.ts",
    "test:deployment": "node --conditions=react-server --import tsx tests/integration/deployment-smoke.ts",
    "db:seed": "node --conditions=react-server --import tsx scripts/seed.ts",
    "admin:create": "node --conditions=react-server --import tsx scripts/create-admin.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.1",
    "framer-motion": "^14.0.0",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
