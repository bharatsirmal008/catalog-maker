generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SourceProvider {
  SHOPIFY
  WOOCOMMERCE
}

enum ProductAvailability {
  IN_STOCK
  OUT_OF_STOCK
  BACKORDER
  UNAVAILABLE
}

enum SyncStatus {
  PENDING
  RUNNING
  SUCCEEDED
  PARTIALLY_SUCCEEDED
  FAILED
}

enum CatalogTemplate {
  GRID
  COLLECTION
}

model SourceConnection {
  id            String         @id @default(uuid()) @db.Uuid
  provider      SourceProvider
  storeUrl      String
  credentialKey String
  enabled       Boolean        @default(false)
  lastSyncAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  products      Product[]
  syncRuns      SyncRun[]

  @@unique([provider, storeUrl])
  @@index([enabled, provider])
}

model Product {
  id                 String              @id @default(uuid()) @db.Uuid
  sourceConnectionId String?             @db.Uuid
  sourceProductId    String?
  name               String
  slug               String              @unique
  description        String?
  sku                String?
  price              Decimal             @db.Decimal(12, 2)
  currency           String              @default("INR") @db.VarChar(3)
  availability       ProductAvailability @default(UNAVAILABLE)
  sourceUrl           String?
  categoryId         String?             @db.Uuid
  isVisible          Boolean             @default(true)
  isFeatured         Boolean             @default(false)
  displayOrder       Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sourceConnection   SourceConnection?   @relation(fields: [sourceConnectionId], references: [id], onDelete: Restrict)
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images             ProductImage[]
  variants           ProductVariant[]

  @@unique([sourceConnectionId, sourceProductId])
  @@index([categoryId, isVisible, displayOrder])
  @@index([name])
  @@index([sku])
  @@index([availability, isVisible])
}

model Category {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  slug         String     @unique
  parentId     String?    @db.Uuid
  displayOrder Int        @default(0)
  isVisible    Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  parent       Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[] @relation("CategoryHierarchy")
  products     Product[]

  @@index([parentId, isVisible, displayOrder])
}

model ProductImage {
  id           String  @id @default(uuid()) @db.Uuid
  productId    String  @db.Uuid
  imageUrl     String
  altText      String?
  displayOrder Int     @default(0)
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, displayOrder])
  @@index([productId])
}

model ProductVariant {
  id              String   @id @default(uuid()) @db.Uuid
  productId       String   @db.Uuid
  sourceVariantId String?
  sku             String?
  title           String
  price           Decimal  @db.Decimal(12, 2)
  stockQuantity   Int?
  attributes      Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sourceVariantId])
  @@index([productId])
  @@index([sku])
}

model SyncRun {
  id                 String           @id @default(uuid()) @db.Uuid
  sourceConnectionId String           @db.Uuid
  status             SyncStatus       @default(PENDING)
  importedCount      Int              @default(0)
  updatedCount       Int              @default(0)
  skippedCount       Int              @default(0)
  failedCount        Int              @default(0)
  startedAt          DateTime         @default(now())
  completedAt        DateTime?
  errorSummary       String?
  sourceConnection   SourceConnection @relation(fields: [sourceConnectionId], references: [id], onDelete: Restrict)

  @@index([sourceConnectionId, startedAt])
  @@index([status, startedAt])
}

model CatalogConfig {
  id             String          @id @default(uuid()) @db.Uuid
  businessName   String
  whatsappNumber String?
  activeTemplate CatalogTemplate @default(GRID)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model AdminUser {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String?
  authSubject  String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
